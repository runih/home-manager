// Swedish (Macintosh, internal keyboard fix)
//
// This MacBook's internal keyboard reports the section key (top-left,
// physically under Esc) and the ISO extra key (next to left Shift) with
// their keycodes swapped relative to a standard PC ISO keyboard: pressing
// the physical top-left key sends the LSGT keycode and vice versa. The
// stock se(mac) variant assigns the right symbols to the right *logical*
// keys, but that hardware swap still lands them on the wrong physical key.
// Undo it by swapping the symbols back between the two.

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "se(mac)"

    name[Group1] = "Swedish (Macintosh, internal keyboard fix)";

    key <TLDE> { [ less, greater, bar, brokenbar ] };
    key <LSGT> { [ section, degree ] };
};
